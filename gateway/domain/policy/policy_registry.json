  "demo_policy": true,
  "disclaimer": "Fictional demo operating policy. Not real carrier or industry standards.",
  "authority": "PROJECT_SPEC.md, approved V1 final revision",
  "thresholds": {
    "LATE_ESCALATE_HOURS": {
      "value": 24,
      "unit": "elapsed_hours",
      "operator": ">="
    },
    "STALE_DETECT_HOURS": {
      "value": 24,
      "unit": "elapsed_hours",
      "operator": ">"
    },
    "STALE_ESCALATE_HOURS": {
      "value": 48,
      "unit": "elapsed_hours",
      "operator": ">="
    },
    "FAILED_ATTEMPTS_ESCALATE": {
      "value": 2,
      "unit": "unique_valid_attempts",
      "operator": ">="
    },
    "ADDRESS_ACTIVE_ESCALATES": {
      "value": true,
      "unit": "boolean",
      "operator": "enabled"
    }
  },
  "late_detection_contract": "Open shipment AND as_of > promised_delivery_at; equality is not late.",
  "open_statuses": [
    "PRE_TRANSIT",
    "IN_TRANSIT",
    "OUT_FOR_DELIVERY",
    "EXCEPTION"
  ],
  "closed_statuses": [
    "DELIVERED",
    "CANCELLED"
  ],
  "qualifying_physical_scans": [
    "ACCEPTED",
    "IN_TRANSIT",
    "OUT_FOR_DELIVERY",
    "ATTEMPT_FAILED",
    "DELIVERED"
  ],
  "dependency_principle": "Missing information blocks only decisions that depend on it unless it invalidates the shipment-level assessment.",
  "aggregation_contract": [
    "Any shipment-level blocker => NEEDS_REVIEW",
    "Otherwise any category READY_TO_ESCALATE => READY_TO_ESCALATE",
    "Otherwise any category NEEDS_REVIEW => NEEDS_REVIEW",
    "Otherwise any category MONITOR => MONITOR",
    "Otherwise NORMAL"
  ],
  "lifecycle_contract": [
    "Failed attempts remain relevant until valid shipment closure.",
    "Address clears only through a later explicit ADDRESS_CLEARED.",
    "No inferred recovery, cooldown window or carrier-specific rule."
  ],
  "ready_contract": "Human review only. A ready category does not erase unrelated gaps; no actions approved or executed.",
